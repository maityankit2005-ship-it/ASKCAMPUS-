# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGO_URI=mongodb://127.0.0.1:27017/askcampus

# JWT Secrets (Change these to strong random strings in production)
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# AI API Configuration (Optional - OpenAI-compatible or Gemini/OpenAI endpoint)
# Leave AI_API_KEY empty to use the built-in database FAQ matching fallback
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# Seed Admin Setup (Used only when running `npm run seed`)
SEED_ADMIN_NAME=Campus Admin
SEED_ADMIN_EMAIL=admin@askcampus.edu
SEED_ADMIN_PASSWORD=ChangeMe123!
